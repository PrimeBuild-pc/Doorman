{
  "name": "doorman",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:web": "pnpm --filter @doorman/web dev",
    "dev:bot": "pnpm --filter @doorman/bot dev",
    "build": "pnpm -r build",
