# Manual copy: cp -n .env.example .env && chmod 600 .env
# The installer generates these values without overwriting .env.
# Do not share .env, `docker compose config` output or credentials in logs.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Generate two separate values with: openssl rand -hex 32
AUTH_SECRET=
# Use only URL-safe characters (the value is inserted into the PostgreSQL URL).
POSTGRES_PASSWORD=

# Origin without a trailing slash; OAuth redirect: <PUBLIC_URL>/api/auth/callback.
# HTTP is local-only; remote access requires HTTPS with a reverse proxy.
PUBLIC_URL=http://localhost:3000
DOORMAN_BIND_ADDRESS=127.0.0.1
DOORMAN_PORT=3000

# Compose builds DATABASE_URL and sets UPLOADS_DIR: do not add them here.
# For development outside Docker, export DATABASE_URL with localhost as the host
# and UPLOADS_DIR with a writable local path; see docs/development.md.
