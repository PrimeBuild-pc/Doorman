# Copia manuale: cp -n .env.example .env && chmod 600 .env
# L'installer genera questi valori senza sovrascrivere .env.
# Non condividere .env, output `docker compose config` o credenziali nei log.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Genera due valori distinti con: openssl rand -hex 32
AUTH_SECRET=
# Usa solo caratteri URL-safe (il valore viene inserito nell'URL PostgreSQL).
POSTGRES_PASSWORD=

# Origine senza slash finale; redirect OAuth: <PUBLIC_URL>/api/auth/callback.
# HTTP solo locale; per accesso remoto HTTPS con reverse proxy.
PUBLIC_URL=http://localhost:3000
DOORMAN_BIND_ADDRESS=127.0.0.1
DOORMAN_PORT=3000

# Compose costruisce DATABASE_URL e imposta UPLOADS_DIR: non aggiungerli qui.
# Per sviluppo fuori Docker, esporta DATABASE_URL con host localhost e
# UPLOADS_DIR con un percorso locale scrivibile; vedi docs/development.md.
