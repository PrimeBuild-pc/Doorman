# Discord Developer Portal -> Doorman app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# General Information tab
DISCORD_CLIENT_ID=
# OAuth2 tab -> Client Secret
DISCORD_CLIENT_SECRET=

# Signs the dashboard's login cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL the dashboard is reachable at (must match the OAuth2 redirect you add
# in the Discord Developer Portal: <PUBLIC_URL>/api/auth/callback).
PUBLIC_URL=http://localhost:3000
DOORMAN_PORT=3000

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://doorman:change-me@db:5432/doorman
UPLOADS_DIR=/data/uploads
